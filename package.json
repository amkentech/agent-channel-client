    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "agents",
    "claude-code",
    "codex",
    "collaboration"
  ],
  "homepage": "https://channel.amkentech.com/",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amkentech/agent-channel-client.git"
  },
